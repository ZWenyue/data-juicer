{
  "codebase_version": "v2.0",
  "robot_type": "r1_lite_ego_retarget",
  "total_episodes": 1,
  "total_frames": 8,
  "total_tasks": 1,
  "total_videos": 1,
  "total_chunks": 1,
  "chunks_size": 1000,
  "fps": 10,
  "splits": {
    "train": "0:1"
  },
  "data_path": "data/chunk-{episode_chunk:03d}/episode_{episode_index:06d}.parquet",
  "video_path": "videos/chunk-{episode_chunk:03d}/{video_key}/episode_{episode_index:06d}.mp4",
  "features": {
    "observation.state": {
      "dtype": "float32",
      "shape": [
        16
      ]
    },
    "action": {
      "dtype": "float32",
      "shape": [
        14
      ]
    },
    "observation.images.image": {
      "dtype": "video",
      "shape": [
        240,
        320,
        3
      ],
      "names": [
        "height",
        "width",
        "channels"
      ],
      "info": {
        "video.height": 240,
        "video.width": 320,
        "video.channels": 3,
        "video.codec": "h264",
        "video.pix_fmt": "yuv420p",
        "video.is_depth_map": false,
        "video.fps": 10,
        "has_audio": false
      }
    },
    "timestamp": {
      "dtype": "float32",
      "shape": [
        1
      ],
      "names": null
    },
    "frame_index": {
      "dtype": "int64",
      "shape": [
        1
      ],
      "names": null
    },
    "episode_index": {
      "dtype": "int64",
      "shape": [
        1
      ],
      "names": null
    },
    "index": {
      "dtype": "int64",
      "shape": [
        1
      ],
      "names": null
    },
    "task_index": {
      "dtype": "int64",
      "shape": [
        1
      ],
      "names": null
    }
  },
  "dual_arm": true,
  "state_layout": "right(8)||left(8)",
  "action_layout": "right(7)||left(7)"
}